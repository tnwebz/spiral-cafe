# Spiral Cafe Environment Variables Template

# Active Online Payment Provider ("razorpay" | "zoho")
PAYMENT_PROVIDER=razorpay

# Supabase PostgreSQL & Realtime
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Supabase Storage (Bucket: "spiral-cafe" used for all food photography)
# No extra variables needed; uses NEXT_PUBLIC_SUPABASE_URL and SUPABASE_SECRET_KEY above.

# Razorpay Payment Gateway (Test Mode / Live)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Zoho Payments Gateway (Future Placeholder)
ZOHO_PAYMENTS_CLIENT_ID=
ZOHO_PAYMENTS_CLIENT_SECRET=
ZOHO_PAYMENTS_ACCOUNT_ID=

# SMS Service Configuration
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_SENDER_ID=SPIRAL
SMS_TEMPLATE_ID=
