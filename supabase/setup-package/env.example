# ==============================================================================
# SPIRAL CAFE — RESTAURANT OWNER SUPABASE & ENVIRONMENT CONFIGURATION
# Template file: Copy to .env.local for local testing, or configure in Cloudflare
# ==============================================================================

# 1. PRIMARY SUPABASE PROJECT CREDENTIALS (NEW RESTAURANT OWNER PROJECT)
# Obtain these from: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR_NEW_PROJECT_REF].supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SECRET_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. ONLINE PAYMENT GATEWAY (Razorpay)
# Set to 'razorpay' for active payment processing
PAYMENT_PROVIDER=razorpay
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here

# 3. FUTURE PAYMENT GATEWAY (Zoho Payments - Optional Placeholder)
ZOHO_PAYMENTS_CLIENT_ID=
ZOHO_PAYMENTS_CLIENT_SECRET=
ZOHO_PAYMENTS_ACCOUNT_ID=

# 4. CUSTOMER SMS & INVOICE NOTIFICATIONS (Optional / Default 'mock')
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_SENDER_ID=SPIRAL
SMS_TEMPLATE_ID=

# ==============================================================================
# CLOUDFLARE WORKERS DEPLOYMENT INSTRUCTIONS
# When ready to switch production, update your Cloudflare Worker environment:
#
# npx wrangler secret put SUPABASE_SECRET_KEY
# npx wrangler secret put RAZORPAY_KEY_SECRET
#
# Update public variables in wrangler.json / .dev.vars:
# - NEXT_PUBLIC_SUPABASE_URL
# - NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
# ==============================================================================
